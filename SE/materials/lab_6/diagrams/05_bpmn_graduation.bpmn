<?xml version='1.0' encoding='utf-8'?>
<b:definitions xmlns:b="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:d="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_graduation" targetNamespace="urn:omgtu:software-engineering:variant-11" exporter="Skuka reproducible BPMN generator">
  <b:message id="msg_d_start" name="Сообщение для d_start" />
  <b:message id="msg_reply" name="Сообщение для reply" />
  <b:process id="p_dept" name="Кафедра" isExecutable="false">
    <b:startEvent id="start" name="Цикл выпуска">
      <b:outgoing>f1</b:outgoing>
    </b:startEvent>
    <b:userTask id="collect" name="Собрать результаты обучения и аттестации">
      <b:incoming>f1</b:incoming>
      <b:outgoing>f2</b:outgoing>
    </b:userTask>
    <b:exclusiveGateway id="eligible" name="Основания полны?" gatewayDirection="Diverging" default="f8">
      <b:incoming>f2</b:incoming>
      <b:outgoing>f3</b:outgoing>
      <b:outgoing>f8</b:outgoing>
    </b:exclusiveGateway>
    <b:sendTask id="send" name="Передать список и основания выпуска" messageRef="msg_d_start">
      <b:incoming>f3</b:incoming>
      <b:outgoing>f4</b:outgoing>
    </b:sendTask>
    <b:receiveTask id="reply" name="Получить приказ или замечания" messageRef="msg_reply">
      <b:incoming>f4</b:incoming>
      <b:outgoing>f5</b:outgoing>
    </b:receiveTask>
    <b:exclusiveGateway id="issued" name="Приказ получен?" gatewayDirection="Diverging" default="f10">
      <b:incoming>f5</b:incoming>
      <b:outgoing>f6</b:outgoing>
      <b:outgoing>f10</b:outgoing>
    </b:exclusiveGateway>
    <b:userTask id="docs" name="Подготовить документы о выпуске">
      <b:incoming>f6</b:incoming>
      <b:outgoing>f7</b:outgoing>
    </b:userTask>
    <b:endEvent id="end" name="Выпуск оформлен">
      <b:incoming>f7</b:incoming>
    </b:endEvent>
    <b:userTask id="missing" name="Зафиксировать недостающие основания">
      <b:incoming>f8</b:incoming>
      <b:outgoing>f9</b:outgoing>
    </b:userTask>
    <b:endEvent id="blocked" name="Выпуск не допускается">
      <b:incoming>f9</b:incoming>
    </b:endEvent>
    <b:userTask id="correct" name="Разобрать замечания и подготовить исправления">
      <b:incoming>f10</b:incoming>
      <b:outgoing>f11</b:outgoing>
    </b:userTask>
    <b:endEvent id="pending" name="Повторная подача в новом цикле">
      <b:incoming>f11</b:incoming>
    </b:endEvent>
    <b:sequenceFlow id="f1" sourceRef="start" targetRef="collect" />
    <b:sequenceFlow id="f2" sourceRef="collect" targetRef="eligible" />
    <b:sequenceFlow id="f3" sourceRef="eligible" targetRef="send" name="Да">
      <b:conditionExpression xsi:type="b:tFormalExpression">eligible_condition = true</b:conditionExpression>
    </b:sequenceFlow>
    <b:sequenceFlow id="f4" sourceRef="send" targetRef="reply" />
    <b:sequenceFlow id="f5" sourceRef="reply" targetRef="issued" />
    <b:sequenceFlow id="f6" sourceRef="issued" targetRef="docs" name="Да">
      <b:conditionExpression xsi:type="b:tFormalExpression">issued_condition = true</b:conditionExpression>
    </b:sequenceFlow>
    <b:sequenceFlow id="f7" sourceRef="docs" targetRef="end" />
    <b:sequenceFlow id="f8" sourceRef="eligible" targetRef="missing" name="Нет" />
    <b:sequenceFlow id="f9" sourceRef="missing" targetRef="blocked" />
    <b:sequenceFlow id="f10" sourceRef="issued" targetRef="correct" name="Нет" />
    <b:sequenceFlow id="f11" sourceRef="correct" targetRef="pending" />
  </b:process>
  <b:process id="p_dean" name="Деканат" isExecutable="false">
    <b:startEvent id="d_start" name="Основания получены">
      <b:outgoing>d_f1</b:outgoing>
      <b:messageEventDefinition id="msgdef_d_start" messageRef="msg_d_start" />
    </b:startEvent>
    <b:userTask id="d_check" name="Проверить основания и решение аттестации">
      <b:incoming>d_f1</b:incoming>
      <b:outgoing>d_f2</b:outgoing>
    </b:userTask>
    <b:exclusiveGateway id="d_ok" name="Выпуск допустим?" gatewayDirection="Diverging" default="d_f6">
      <b:incoming>d_f2</b:incoming>
      <b:outgoing>d_f3</b:outgoing>
      <b:outgoing>d_f6</b:outgoing>
    </b:exclusiveGateway>
    <b:userTask id="d_issue" name="Оформить приказ о выпуске">
      <b:incoming>d_f3</b:incoming>
      <b:outgoing>d_f4</b:outgoing>
    </b:userTask>
    <b:sendTask id="d_order" name="Передать приказ кафедре" messageRef="msg_reply">
      <b:incoming>d_f4</b:incoming>
      <b:outgoing>d_f5</b:outgoing>
    </b:sendTask>
    <b:endEvent id="d_end" name="Приказ передан">
      <b:incoming>d_f5</b:incoming>
    </b:endEvent>
    <b:sendTask id="d_comments" name="Передать замечания кафедре" messageRef="msg_reply">
      <b:incoming>d_f6</b:incoming>
      <b:outgoing>d_f7</b:outgoing>
    </b:sendTask>
    <b:endEvent id="d_pending" name="Выпуск отложен">
      <b:incoming>d_f7</b:incoming>
    </b:endEvent>
    <b:sequenceFlow id="d_f1" sourceRef="d_start" targetRef="d_check" />
    <b:sequenceFlow id="d_f2" sourceRef="d_check" targetRef="d_ok" />
    <b:sequenceFlow id="d_f3" sourceRef="d_ok" targetRef="d_issue" name="Да">
      <b:conditionExpression xsi:type="b:tFormalExpression">d_ok_condition = true</b:conditionExpression>
    </b:sequenceFlow>
    <b:sequenceFlow id="d_f4" sourceRef="d_issue" targetRef="d_order" />
    <b:sequenceFlow id="d_f5" sourceRef="d_order" targetRef="d_end" />
    <b:sequenceFlow id="d_f6" sourceRef="d_ok" targetRef="d_comments" name="Нет" />
    <b:sequenceFlow id="d_f7" sourceRef="d_comments" targetRef="d_pending" />
  </b:process>
  <b:collaboration id="collab_graduation" name="Проверка оснований и оформление выпуска студентов">
    <b:participant id="participant_dept" name="Кафедра" processRef="p_dept" />
    <b:participant id="participant_dean" name="Деканат" processRef="p_dean" />
    <b:messageFlow id="m_list" name="Список и основания" sourceRef="send" targetRef="d_start" messageRef="msg_d_start" />
    <b:messageFlow id="m_order" name="Приказ о выпуске" sourceRef="d_order" targetRef="reply" messageRef="msg_reply" />
    <b:messageFlow id="m_comments" name="Замечания" sourceRef="d_comments" targetRef="reply" messageRef="msg_reply" />
  </b:collaboration>

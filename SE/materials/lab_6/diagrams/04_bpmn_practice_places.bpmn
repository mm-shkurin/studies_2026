<?xml version='1.0' encoding='utf-8'?>
<b:definitions xmlns:b="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:d="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_practice_places" targetNamespace="urn:omgtu:software-engineering:variant-11" exporter="Skuka reproducible BPMN generator">
  <b:message id="msg_b_directions" name="Сообщение для b_directions" />
  <b:message id="msg_b_start" name="Сообщение для b_start" />
  <b:message id="msg_reply" name="Сообщение для reply" />
  <b:process id="p_dept" name="Кафедра" isExecutable="false">
    <b:startEvent id="start" name="Потребность в местах">
      <b:outgoing>f1</b:outgoing>
    </b:startEvent>
    <b:exclusiveGateway id="merge" name="" gatewayDirection="Converging">
      <b:incoming>f1</b:incoming>
      <b:incoming>f9</b:incoming>
      <b:outgoing>f2</b:outgoing>
    </b:exclusiveGateway>
    <b:userTask id="select" name="Сопоставить студентов и подходящую базу">
      <b:incoming>f2</b:incoming>
      <b:outgoing>f3</b:outgoing>
    </b:userTask>
    <b:sendTask id="request" name="Направить заявку на места" messageRef="msg_b_start">
      <b:incoming>f3</b:incoming>
      <b:outgoing>f4</b:outgoing>
    </b:sendTask>
    <b:receiveTask id="reply" name="Получить ответ о местах" messageRef="msg_reply">
      <b:incoming>f4</b:incoming>
      <b:outgoing>f5</b:outgoing>
    </b:receiveTask>
    <b:exclusiveGateway id="places" name="Места выделены?" gatewayDirection="Diverging" default="f8">
      <b:incoming>f5</b:incoming>
      <b:outgoing>f6</b:outgoing>
      <b:outgoing>f8</b:outgoing>
    </b:exclusiveGateway>
    <b:sendTask id="directions" name="Закрепить места и передать направления" messageRef="msg_b_directions">
      <b:incoming>f6</b:incoming>
      <b:outgoing>f7</b:outgoing>
    </b:sendTask>
    <b:endEvent id="end" name="Места предоставлены">
      <b:incoming>f7</b:incoming>
    </b:endEvent>
    <b:userTask id="other" name="Выбрать другую базу практики">
      <b:incoming>f8</b:incoming>
      <b:outgoing>f9</b:outgoing>
    </b:userTask>
    <b:sequenceFlow id="f1" sourceRef="start" targetRef="merge" />
    <b:sequenceFlow id="f2" sourceRef="merge" targetRef="select" />
    <b:sequenceFlow id="f3" sourceRef="select" targetRef="request" />
    <b:sequenceFlow id="f4" sourceRef="request" targetRef="reply" />
    <b:sequenceFlow id="f5" sourceRef="reply" targetRef="places" />
    <b:sequenceFlow id="f6" sourceRef="places" targetRef="directions" name="Да">
      <b:conditionExpression xsi:type="b:tFormalExpression">places_condition = true</b:conditionExpression>
    </b:sequenceFlow>
    <b:sequenceFlow id="f7" sourceRef="directions" targetRef="end" />
    <b:sequenceFlow id="f8" sourceRef="places" targetRef="other" name="Нет" />
    <b:sequenceFlow id="f9" sourceRef="other" targetRef="merge" />
  </b:process>
  <b:process id="p_partner" name="База практики" isExecutable="false">
    <b:startEvent id="b_start" name="Заявка получена">
      <b:outgoing>b_f1</b:outgoing>
      <b:messageEventDefinition id="msgdef_b_start" messageRef="msg_b_start" />
    </b:startEvent>
    <b:userTask id="b_check" name="Проверить вместимость и профиль мест">
      <b:incoming>b_f1</b:incoming>
      <b:outgoing>b_f2</b:outgoing>
    </b:userTask>
    <b:exclusiveGateway id="b_ok" name="Есть места?" gatewayDirection="Diverging" default="b_f6">
      <b:incoming>b_f2</b:incoming>
      <b:outgoing>b_f3</b:outgoing>
      <b:outgoing>b_f6</b:outgoing>
    </b:exclusiveGateway>
    <b:sendTask id="b_yes" name="Подтвердить предоставление мест" messageRef="msg_reply">
      <b:incoming>b_f3</b:incoming>
      <b:outgoing>b_f4</b:outgoing>
    </b:sendTask>
    <b:receiveTask id="b_directions" name="Получить направления студентов" messageRef="msg_b_directions">
      <b:incoming>b_f4</b:incoming>
      <b:outgoing>b_f5</b:outgoing>
    </b:receiveTask>
    <b:endEvent id="b_end" name="Места закреплены">
      <b:incoming>b_f5</b:incoming>
    </b:endEvent>
    <b:sendTask id="b_no" name="Передать отказ" messageRef="msg_reply">
      <b:incoming>b_f6</b:incoming>
      <b:outgoing>b_f7</b:outgoing>
    </b:sendTask>
    <b:endEvent id="b_no_end" name="Заявка отклонена">
      <b:incoming>b_f7</b:incoming>
    </b:endEvent>
    <b:sequenceFlow id="b_f1" sourceRef="b_start" targetRef="b_check" />
    <b:sequenceFlow id="b_f2" sourceRef="b_check" targetRef="b_ok" />
    <b:sequenceFlow id="b_f3" sourceRef="b_ok" targetRef="b_yes" name="Да">
      <b:conditionExpression xsi:type="b:tFormalExpression">b_ok_condition = true</b:conditionExpression>
    </b:sequenceFlow>
    <b:sequenceFlow id="b_f4" sourceRef="b_yes" targetRef="b_directions" />
    <b:sequenceFlow id="b_f5" sourceRef="b_directions" targetRef="b_end" />
    <b:sequenceFlow id="b_f6" sourceRef="b_ok" targetRef="b_no" name="Нет" />
    <b:sequenceFlow id="b_f7" sourceRef="b_no" targetRef="b_no_end" />
  </b:process>
  <b:collaboration id="collab_practice_places" name="Предоставление мест для прохождения практики">
    <b:participant id="participant_dept" name="Кафедра" processRef="p_dept" />
    <b:participant id="participant_partner" name="База практики" processRef="p_partner" />
    <b:messageFlow id="m_request" name="Заявка" sourceRef="request" targetRef="b_start" messageRef="msg_b_start" />
    <b:messageFlow id="m_confirmation" name="Подтверждение" sourceRef="b_yes" targetRef="reply" messageRef="msg_reply" />
    <b:messageFlow id="m_refusal" name="Отказ" sourceRef="b_no" targetRef="reply" messageRef="msg_reply" />
    <b:messageFlow id="m_directions" name="Направления" sourceRef="directions" targetRef="b_directions" messageRef="msg_b_directions" />
  </b:collaboration>
  <d:BPMNDiagram id="diagram_practice_places">
    <d:BPMNPlane id="plane_practice_places" bpmnElement="collab_practice_places">

        <di:waypoint x="1685" y="172" />
        <di:waypoint x="1720" y="172" />
        <d:BPMNLabel>
          <dc:Bounds x="1647" y="166" width="40" height="22" />
        </d:BPMNLabel>
      </d:BPMNEdge>
      <d:BPMNEdge id="edge_f_end" bpmnElement="f_end">
        <di:waypoint x="1910" y="172" />
        <di:waypoint x="1930" y="172" />
        <di:waypoint x="1930" y="190" />
        <di:waypoint x="1950" y="190" />
      </d:BPMNEdge>
      <d:BPMNEdge id="edge_f_no" bpmnElement="f_no">
        <di:waypoint x="1625" y="217" />
        <di:waypoint x="1625" y="322" />
        <di:waypoint x="1720" y="322" />
        <d:BPMNLabel>
          <dc:Bounds x="1633" y="258" width="40" height="22" />
        </d:BPMNLabel>
      </d:BPMNEdge>
      <d:BPMNEdge id="edge_f_loop" bpmnElement="f_loop">
        <di:waypoint x="1815" y="359" />
        <di:waypoint x="1815" y="380" />
        <di:waypoint x="310" y="380" />
        <di:waypoint x="310" y="192" />
        <di:waypoint x="345" y="192" />
      </d:BPMNEdge>
      <d:BPMNEdge id="edge_h_f1" bpmnElement="h_f1">
        <di:waypoint x="1180" y="550" />
        <di:waypoint x="1215" y="550" />
        <di:waypoint x="1215" y="552" />
        <di:waypoint x="1250" y="552" />
      </d:BPMNEdge>
      <d:BPMNEdge id="edge_h_f2" bpmnElement="h_f2">
        <di:waypoint x="1440" y="552" />
        <di:waypoint x="1480" y="552" />
      </d:BPMNEdge>
      <d:BPMNEdge id="edge_h_f3" bpmnElement="h_f3">
        <di:waypoint x="1530" y="552" />
        <di:waypoint x="1565" y="552" />
        <di:waypoint x="1565" y="532" />
        <di:waypoint x="1600" y="532" />
        <d:BPMNLabel>
          <dc:Bounds x="1527" y="526" width="40" height="22" />
        </d:BPMNLabel>
      </d:BPMNEdge>
      <d:BPMNEdge id="edge_h_f4" bpmnElement="h_f4">
        <di:waypoint x="1505" y="577" />

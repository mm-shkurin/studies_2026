<?xml version='1.0' encoding='utf-8'?>
<b:definitions xmlns:b="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:d="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_curriculum" targetNamespace="urn:omgtu:software-engineering:variant-11" exporter="Skuka reproducible BPMN generator">
  <b:message id="msg_h_start" name="Сообщение для h_start" />
  <b:message id="msg_reply" name="Сообщение для reply" />
  <b:process id="p_dept" name="Кафедра" isExecutable="false">
    <b:startEvent id="start" name="Цикл планирования">
      <b:outgoing>f_start</b:outgoing>
    </b:startEvent>
    <b:exclusiveGateway id="merge" name="" gatewayDirection="Converging">
      <b:incoming>f_start</b:incoming>
      <b:incoming>f_loop</b:incoming>
      <b:outgoing>f_action_0</b:outgoing>
    </b:exclusiveGateway>
    <b:userTask id="action_0" name="Собрать требования образовательной программы">
      <b:incoming>f_action_0</b:incoming>
      <b:outgoing>f_action_1</b:outgoing>
    </b:userTask>
    <b:userTask id="action_1" name="Разработать структуру дисциплин и практик">
      <b:incoming>f_action_1</b:incoming>
      <b:outgoing>f_action_2</b:outgoing>
    </b:userTask>
    <b:userTask id="action_2" name="Проверить состав и объём учебного плана">
      <b:incoming>f_action_2</b:incoming>
      <b:outgoing>f_send</b:outgoing>
    </b:userTask>
    <b:sendTask id="send" name="Передать проект на согласование" messageRef="msg_h_start">
      <b:incoming>f_send</b:incoming>
      <b:outgoing>f_reply</b:outgoing>
    </b:sendTask>
    <b:receiveTask id="reply" name="Получить решение" messageRef="msg_reply">
      <b:incoming>f_reply</b:incoming>
      <b:outgoing>f_decision</b:outgoing>
    </b:receiveTask>
    <b:exclusiveGateway id="approved" name="Согласовано?" gatewayDirection="Diverging" default="f_no">
      <b:incoming>f_decision</b:incoming>
      <b:outgoing>f_yes</b:outgoing>
      <b:outgoing>f_no</b:outgoing>
    </b:exclusiveGateway>
    <b:userTask id="publish" name="Зафиксировать утверждённую версию учебного плана">
      <b:incoming>f_yes</b:incoming>
      <b:outgoing>f_end</b:outgoing>
    </b:userTask>
    <b:endEvent id="end" name="Учебный план утверждён">
      <b:incoming>f_end</b:incoming>
    </b:endEvent>
    <b:userTask id="correct" name="Учесть замечания и исправить проект">
      <b:incoming>f_no</b:incoming>
      <b:outgoing>f_loop</b:outgoing>
    </b:userTask>
    <b:sequenceFlow id="f_start" sourceRef="start" targetRef="merge" />
    <b:sequenceFlow id="f_action_0" sourceRef="merge" targetRef="action_0" />
    <b:sequenceFlow id="f_action_1" sourceRef="action_0" targetRef="action_1" />
    <b:sequenceFlow id="f_action_2" sourceRef="action_1" targetRef="action_2" />
    <b:sequenceFlow id="f_send" sourceRef="action_2" targetRef="send" />
    <b:sequenceFlow id="f_reply" sourceRef="send" targetRef="reply" />
    <b:sequenceFlow id="f_decision" sourceRef="reply" targetRef="approved" />
    <b:sequenceFlow id="f_yes" sourceRef="approved" targetRef="publish" name="Да">
      <b:conditionExpression xsi:type="b:tFormalExpression">approved_condition = true</b:conditionExpression>
    </b:sequenceFlow>
    <b:sequenceFlow id="f_end" sourceRef="publish" targetRef="end" />
    <b:sequenceFlow id="f_no" sourceRef="approved" targetRef="correct" name="Нет" />
    <b:sequenceFlow id="f_loop" sourceRef="correct" targetRef="merge" />
  </b:process>
  <b:process id="p_head" name="Заведующий кафедрой" isExecutable="false">
    <b:startEvent id="h_start" name="Проект получен">
      <b:outgoing>h_f1</b:outgoing>
      <b:messageEventDefinition id="msgdef_h_start" messageRef="msg_h_start" />
    </b:startEvent>
    <b:userTask id="h_review" name="Проверить проект учебного плана">
      <b:incoming>h_f1</b:incoming>
      <b:outgoing>h_f2</b:outgoing>
    </b:userTask>
    <b:exclusiveGateway id="h_ok" name="Проект принят?" gatewayDirection="Diverging" default="h_f4">
      <b:incoming>h_f2</b:incoming>
      <b:outgoing>h_f3</b:outgoing>
      <b:outgoing>h_f4</b:outgoing>
    </b:exclusiveGateway>
    <b:sendTask id="h_yes" name="Передать утверждение" messageRef="msg_reply">
      <b:incoming>h_f3</b:incoming>
      <b:outgoing>h_f5</b:outgoing>
    </b:sendTask>
    <b:sendTask id="h_no" name="Передать замечания" messageRef="msg_reply">
      <b:incoming>h_f4</b:incoming>
      <b:outgoing>h_f6</b:outgoing>
    </b:sendTask>
    <b:endEvent id="h_end_yes" name="Согласовано">
      <b:incoming>h_f5</b:incoming>
    </b:endEvent>
    <b:endEvent id="h_end_no" name="На доработке">
      <b:incoming>h_f6</b:incoming>
    </b:endEvent>
    <b:sequenceFlow id="h_f1" sourceRef="h_start" targetRef="h_review" />
    <b:sequenceFlow id="h_f2" sourceRef="h_review" targetRef="h_ok" />
    <b:sequenceFlow id="h_f3" sourceRef="h_ok" targetRef="h_yes" name="Да">
      <b:conditionExpression xsi:type="b:tFormalExpression">h_ok_condition = true</b:conditionExpression>
    </b:sequenceFlow>
    <b:sequenceFlow id="h_f4" sourceRef="h_ok" targetRef="h_no" name="Нет" />
    <b:sequenceFlow id="h_f5" sourceRef="h_yes" targetRef="h_end_yes" />
    <b:sequenceFlow id="h_f6" sourceRef="h_no" targetRef="h_end_no" />
  </b:process>
  <b:collaboration id="collab_curriculum" name="Разработка и утверждение учебного плана">
    <b:participant id="participant_dept" name="Кафедра" processRef="p_dept" />
    <b:participant id="participant_head" name="Заведующий кафедрой" processRef="p_head" />
    <b:messageFlow id="m_draft" name="Версия проекта" sourceRef="send" targetRef="h_start" messageRef="msg_h_start" />
    <b:messageFlow id="m_approval" name="Утверждение" sourceRef="h_yes" targetRef="reply" messageRef="msg_reply" />
    <b:messageFlow id="m_rework" name="Замечания" sourceRef="h_no" targetRef="reply" messageRef="msg_reply" />
  </b:collaboration>
  <d:BPMNDiagram id="diagram_curriculum">
    <d:BPMNPlane id="plane_curriculum" bpmnElement="collab_curriculum">
      <d:BPMNShape id="shape_participant_dept" bpmnElement="participant_dept" isHorizontal="true">
        <dc:Bounds x="40" y="100" width="2010" height="300" />
      </d:BPMNShape>
      <d:BPMNShape id="shape_participant_head" bpmnElement="participant_head" isHorizontal="true">
        <dc:Bounds x="40" y="460" width="2010" height="300" />
      </d:BPMNShape>
      <d:BPMNShape id="shape_start" bpmnElement="start" isMarkerVisible="true">
        <dc:Bounds x="240" y="170" width="40" height="40" />
        <d:BPMNLabel>
          <dc:Bounds x="200" y="218" width="130" height="45" />
        </d:BPMNLabel>
      </d:BPMNShape>
      <d:BPMNShape id="shape_merge" bpmnElement="merge" isMarkerVisible="true">
        <dc:Bounds x="345" y="167" width="50" height="50" />

      </d:BPMNEdge>
      <d:BPMNEdge id="edge_f_reply" bpmnElement="f_reply">
        <di:waypoint x="1330" y="192" />
        <di:waypoint x="1370" y="192" />
      </d:BPMNEdge>
      <d:BPMNEdge id="edge_f_decision" bpmnElement="f_decision">
        <di:waypoint x="1560" y="192" />
        <di:waypoint x="1600" y="192" />
      </d:BPMNEdge>
      <d:BPMNEdge id="edge_f_yes" bpmnElement="f_yes">
        <di:waypoint x="1650" y="192" />

<?xml version='1.0' encoding='utf-8'?>
<b:definitions xmlns:b="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:d="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_student_contingent" targetNamespace="urn:omgtu:software-engineering:variant-11" exporter="Skuka reproducible BPMN generator">
  <b:message id="msg_c_start" name="Сообщение для c_start" />
  <b:message id="msg_d_clarify" name="Сообщение для d_clarify" />
  <b:message id="msg_k_start" name="Сообщение для k_start" />
  <b:process id="p_dean" name="Деканат" isExecutable="false">
    <b:startEvent id="d_start" name="Приказ издан">
      <b:outgoing>d_f1</b:outgoing>
    </b:startEvent>
    <b:sendTask id="d_send" name="Передать приказ кафедре" messageRef="msg_k_start">
      <b:incoming>d_f1</b:incoming>
      <b:outgoing>d_f2</b:outgoing>
    </b:sendTask>
    <b:endEvent id="d_end" name="Приказ передан">
      <b:incoming>d_f2</b:incoming>
    </b:endEvent>
    <b:startEvent id="d_clarify" name="Запрос уточнения">
      <b:outgoing>d_f3</b:outgoing>
      <b:messageEventDefinition id="msgdef_d_clarify" messageRef="msg_d_clarify" />
    </b:startEvent>
    <b:userTask id="d_fix" name="Уточнить реквизиты приказа">
      <b:incoming>d_f3</b:incoming>
      <b:outgoing>d_f4</b:outgoing>
    </b:userTask>
    <b:sendTask id="d_resend" name="Передать исправленный приказ" messageRef="msg_k_start">
      <b:incoming>d_f4</b:incoming>
      <b:outgoing>d_f5</b:outgoing>
    </b:sendTask>
    <b:endEvent id="d_fix_end" name="Уточнение отправлено">
      <b:incoming>d_f5</b:incoming>
    </b:endEvent>
    <b:sequenceFlow id="d_f1" sourceRef="d_start" targetRef="d_send" />
    <b:sequenceFlow id="d_f2" sourceRef="d_send" targetRef="d_end" />
    <b:sequenceFlow id="d_f3" sourceRef="d_clarify" targetRef="d_fix" />
    <b:sequenceFlow id="d_f4" sourceRef="d_fix" targetRef="d_resend" />
    <b:sequenceFlow id="d_f5" sourceRef="d_resend" targetRef="d_fix_end" />
  </b:process>
  <b:process id="p_dept" name="Кафедра" isExecutable="false">
    <b:startEvent id="k_start" name="Приказ получен">
      <b:outgoing>k_f1</b:outgoing>
      <b:messageEventDefinition id="msgdef_k_start" messageRef="msg_k_start" />
    </b:startEvent>
    <b:userTask id="k_check" name="Сверить приказ, студента и группу">
      <b:incoming>k_f1</b:incoming>
      <b:outgoing>k_f2</b:outgoing>
    </b:userTask>
    <b:exclusiveGateway id="k_valid" name="Данные полны?" gatewayDirection="Diverging" default="k_f7">
      <b:incoming>k_f2</b:incoming>
      <b:outgoing>k_f3</b:outgoing>
      <b:outgoing>k_f7</b:outgoing>
    </b:exclusiveGateway>
    <b:serviceTask id="k_update" name="Обновить реестр и журнал изменений">
      <b:incoming>k_f3</b:incoming>
      <b:outgoing>k_f4</b:outgoing>
    </b:serviceTask>
    <b:userTask id="k_assign" name="Закрепить куратора за группой">
      <b:incoming>k_f4</b:incoming>
      <b:outgoing>k_f5</b:outgoing>
    </b:userTask>
    <b:sendTask id="k_send" name="Передать актуальный список" messageRef="msg_c_start">
      <b:incoming>k_f5</b:incoming>
      <b:outgoing>k_f6</b:outgoing>
    </b:sendTask>
    <b:endEvent id="k_end" name="Контингент обновлён">
      <b:incoming>k_f6</b:incoming>
    </b:endEvent>
    <b:sendTask id="k_clarify" name="Запросить уточнение" messageRef="msg_d_clarify">
      <b:incoming>k_f7</b:incoming>
      <b:outgoing>k_f8</b:outgoing>
    </b:sendTask>
    <b:endEvent id="k_hold" name="Изменение отложено">
      <b:incoming>k_f8</b:incoming>
    </b:endEvent>
    <b:sequenceFlow id="k_f1" sourceRef="k_start" targetRef="k_check" />
    <b:sequenceFlow id="k_f2" sourceRef="k_check" targetRef="k_valid" />
    <b:sequenceFlow id="k_f3" sourceRef="k_valid" targetRef="k_update" name="Да">
      <b:conditionExpression xsi:type="b:tFormalExpression">k_valid_condition = true</b:conditionExpression>
    </b:sequenceFlow>
    <b:sequenceFlow id="k_f4" sourceRef="k_update" targetRef="k_assign" />
    <b:sequenceFlow id="k_f5" sourceRef="k_assign" targetRef="k_send" />
    <b:sequenceFlow id="k_f6" sourceRef="k_send" targetRef="k_end" />
    <b:sequenceFlow id="k_f7" sourceRef="k_valid" targetRef="k_clarify" name="Нет" />
    <b:sequenceFlow id="k_f8" sourceRef="k_clarify" targetRef="k_hold" />
  </b:process>
  <b:process id="p_curator" name="Куратор" isExecutable="false">
    <b:startEvent id="c_start" name="Список получен">
      <b:outgoing>c_f1</b:outgoing>
      <b:messageEventDefinition id="msgdef_c_start" messageRef="msg_c_start" />
    </b:startEvent>
    <b:userTask id="c_record" name="Зафиксировать движение контингента">
      <b:incoming>c_f1</b:incoming>
      <b:outgoing>c_f2</b:outgoing>
    </b:userTask>
    <b:exclusiveGateway id="c_need" name="Нужен контакт?" gatewayDirection="Diverging" default="c_f5">
      <b:incoming>c_f2</b:incoming>
      <b:outgoing>c_f3</b:outgoing>
      <b:outgoing>c_f5</b:outgoing>
    </b:exclusiveGateway>
    <b:userTask id="c_contact" name="Связаться со студентом и родителями">
      <b:incoming>c_f3</b:incoming>
      <b:outgoing>c_f4</b:outgoing>
    </b:userTask>
    <b:endEvent id="c_end" name="Сведения актуальны">
      <b:incoming>c_f4</b:incoming>
      <b:incoming>c_f5</b:incoming>
    </b:endEvent>
    <b:sequenceFlow id="c_f1" sourceRef="c_start" targetRef="c_record" />
    <b:sequenceFlow id="c_f2" sourceRef="c_record" targetRef="c_need" />
    <b:sequenceFlow id="c_f3" sourceRef="c_need" targetRef="c_contact" name="Да">
      <b:conditionExpression xsi:type="b:tFormalExpression">c_need_condition = true</b:conditionExpression>
    </b:sequenceFlow>
    <b:sequenceFlow id="c_f4" sourceRef="c_contact" targetRef="c_end" />
    <b:sequenceFlow id="c_f5" sourceRef="c_need" targetRef="c_end" name="Нет" />
  </b:process>
  <b:collaboration id="collab_student_contingent" name="Учёт контингента и кураторское сопровождение">
    <b:participant id="participant_dean" name="Деканат" processRef="p_dean" />
    <b:participant id="participant_dept" name="Кафедра" processRef="p_dept" />
    <b:participant id="participant_curator" name="Куратор" processRef="p_curator" />
    <b:messageFlow id="m_order" name="Приказ" sourceRef="d_send" targetRef="k_start" messageRef="msg_k_start" />
    <b:messageFlow id="m_clarify" name="Запрос уточнения" sourceRef="k_clarify" targetRef="d_clarify" messageRef="msg_d_clarify" />
    <b:messageFlow id="m_corrected" name="Исправленный приказ" sourceRef="d_resend" targetRef="k_start" messageRef="msg_k_start" />
    <b:messageFlow id="m_group" name="Список группы" sourceRef="k_send" targetRef="c_start" messageRef="msg_c_start" />
  </b:collaboration>

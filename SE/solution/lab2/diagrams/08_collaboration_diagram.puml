@startuml CollaborationDiagram
skinparam style strictuml

object "RideUI" as ui <<Boundary>>
object "RideController" as controller <<Control>>
object "Ride" as ride <<Entity>>
object "Driver" as driver <<Entity>>
object "Vehicle" as vehicle <<Entity>>
object "Location" as location <<Entity>>
object "Payment" as payment <<Entity>>
object "Rating" as rating <<Entity>>

ui -- controller : 1. searchVehicles()
ui -- controller : 2. selectDriver()
ui -- controller : 3. confirmRide()
ui -- controller : 7. rateRide()

controller -- location : 1.1. getCoordinates()
controller -- driver : 1.2. findNearbyDrivers()
controller -- driver : 2.1. isAvailable()
controller -- ride : 2.2. create()
controller -- ride : 2.3. calculateCost()
controller -- payment : 3.1. process()
controller -- ride : 3.2. setStatus(PAID)
controller -- ride : 4. assignDriver()
controller -- vehicle : 4.1. assignVehicle()
controller -- ride : 5. setStatus(IN_PROGRESS)
controller -- ride : 6. setStatus(COMPLETED)
controller -- rating : 7.1. create()
controller -- ride : 7.2. addRating()

note right of ui
  1-3: Purchase flow
  7: Post-ride flow
end note

note right of controller
  Coordinates request
  Search drivers
  Check availability
  Create ride
  Calculate cost
  Process payment
  Set status PAID
  Assign driver
  Assign vehicle
  Set status IN_PROGRESS
  Set status COMPLETED
  Create rating
  Add rating to ride
end note
@enduml
